// penumbra transaction types
dictionary PenumbraSpendAction {
    string note_value;
    string note_asset;
    string note_address;
};

dictionary PenumbraOutputAction {
    string value;
    string asset;
    string dest_address;
};

dictionary PenumbraSwapAction {
    string input_value;
    string input_asset;
    string output_asset;
};

dictionary PenumbraDelegateAction {
    string amount;
    string validator;
};

dictionary PenumbraVoteAction {
    u64 proposal_id;
    string vote;
};

dictionary PenumbraTransactionSummary {
    string chain_id;
    u64? expiry_height;
    string fee;
    string fee_asset;
    u64 spend_count;
    u64 output_count;
    string effect_hash;
};

// Penumbra FVK export for watch-only wallet import
// Includes UR-encoded string for hardware wallet QR compatibility
// UR type: penumbra-accounts (CBOR tag 49301)
// Inner type: penumbra-full-viewing-key (CBOR tag 49302)
dictionary PenumbraFvkExport {
    u32 account_index;
    string label;
    string fvk_bech32m;
    string wallet_id_bech32m;
    sequence<u8> qr_data;
    string ur_string;
};

// Cosmos account export for Zafu wallet import
dictionary CosmosAccountExport {
    u32 account_index;
    string label;
    string public_key_hex;
    // Change-level xpub (m/44'/118'/account'/0). Hot wallet derives burner
    // addresses .../0/i from this, watch-only; device signs each at the same i.
    string xpub;
    sequence<CosmosChainAddress> addresses;
    sequence<u8> qr_data;
};

dictionary CosmosChainAddress {
    string chain_id;
    string address;
    string prefix;
};

// Single cosmos message for display
dictionary CosmosMsgDisplay {
    string msg_type;
    string recipient;
    string amount;
    string detail;
    boolean blind;
};

// Cosmos sign request parsed from QR
dictionary CosmosSignRequest {
    u32 account_index;
    u32 address_index;
    string chain_name;
    string chain_id;
    sequence<CosmosMsgDisplay> msgs;
    string fee;
    string memo;
    string raw_qr_hex;
};

// Penumbra sign request parsed from QR
dictionary PenumbraSignRequest {
    string chain_id;
    string effect_hash_hex;
    u32 spend_count;
    u32 vote_count;
    u32 lqt_vote_count;
    string raw_qr_hex;
};

// Penumbra generic action (for unrecognized action types)
dictionary PenumbraGenericAction {
    string action_name;
    string description;
    sequence<StringPair> fields;
    boolean recognized;
    u32 field_number;
};

// String pair for generic action fields
dictionary StringPair {
    string first;
    string second;
};

// Penumbra schema info
dictionary PenumbraSchemaInfo {
    string chain_id;
    string protocol_version;
    u32 action_count;
    u32 schema_version;
};

// ============================================================================
// Zcash cold signing types
// ============================================================================

// Zcash transaction summary
dictionary ZcashTransactionSummary {
    boolean mainnet;
    string fee;
    u64 spend_count;
    u64 output_count;
    string sighash;
    string anchor;
};

// Auth sign result
dictionary AuthSignResult {
    string pubkey_hex;
    string signature_hex;
    string domain;
};

// Zcash simple sign request (parsed from QR)
dictionary ZcashSimpleSignRequest {
    u32 account_index;
    string sighash_hex;
    u32 action_count;
    string summary;
    boolean mainnet;
    string raw_qr_hex;
};

// Signing context: what the signer knows about its balance
dictionary ZcashSignContext {
    u64 verified_balance;
    u32 note_count;
    u32 anchor_height;
    u64 synced_at;
    boolean has_notes;
};

// PCZT inspection result for display before signing.
// Anchor is intentionally not validated — matches the Keystone signing model
// (PCZT is ground truth; signature happens after user review of
// recipient + amount + fee).
dictionary ZcashPcztInspection {
    // Number of actions in the Orchard bundle.
    u32 action_count;
    // Number of actions in the Ironwood bundle (NU6.3 / V6 pool). 0 for a
    // V5 transaction. A turnstile migration is exactly the case where this
    // is non-zero while the Orchard side looks like a pure spend - showing
    // only action_count would render a migration as money leaving with no
    // destination.
    u32 ironwood_action_count;
    // spends: list of (value_zatoshis, nullifier_is_known) pairs.
    // Orchard spends first, then Ironwood spends.
    sequence<ZcashPcztSpend> spends;
    // outputs: list of (value_zatoshis, recipient_hex) pairs.
    // Orchard outputs first, then Ironwood outputs.
    sequence<ZcashPcztOutput> outputs;
    // True fee across all bundles: (transparent in - transparent out)
    //   + sapling value_balance + orchard value_balance
    //   + ironwood value_balance.
    i64 fee_zat;
    // Net value of the Orchard bundle alone (diagnostic; for canonical
    // fee use fee_zat).
    i64 orchard_net_value;
    // Net value of the Ironwood bundle alone (diagnostic; for canonical
    // fee use fee_zat). 0 for a V5 transaction.
    i64 ironwood_net_value;
    // our verified balance (0 if no notes stored)
    u64 verified_balance;
    // how many spend nullifiers match our verified notes
    u32 known_spends;
    // tx_version (v5 = 5)
    u32 tx_version;
    // 8-char lowercase hex consensus branch ID
    string consensus_branch_id_hex;
    // block height at which this tx expires
    u32 expiry_height;
};

dictionary ZcashPcztSpend {
    u64 value;
    string nullifier_hex;
    boolean known;  // matches a verified note we stored
};

dictionary ZcashPcztOutput {
    u64 value;
    string recipient;  // unified address (u1...) or raw hex fallback
};

// FROST multisig wallet summary (no secrets)
dictionary FrostWalletSummaryFFI {
    string wallet_id;
    string label;
    u16 min_signers;
    u16 max_signers;
    boolean mainnet;
    u64 created_at;
};

// Anchor-attestation verifier registry entry
dictionary AnchorVerifierFFI {
    string pubkey_hex;       // 32-byte ed25519 pubkey, hex
    string label;            // human-readable label
    string source;           // "built-in" or "user"
    u64    added_at;         // unix seconds
    boolean enabled;
};

// Decoded ur:zcash-verifier-key payload (preview before adding)
dictionary AnchorVerifierImport {
    string pubkey_hex;       // 32-byte ed25519 pubkey, hex (display in full!)
    string label;            // suggested label from the QR
};

// Zcash Orchard spend action
dictionary ZcashOrchardSpend {
    string nullifier;
    string value;
    string cmx;
};

// Zcash Orchard output action
dictionary ZcashOrchardOutput {
    string value;
    string recipient;
    boolean is_change;
};

// Zcash FVK export for watch-only wallet import
dictionary ZcashFvkExport {
    u32 account_index;
    string label;
    boolean mainnet;
    string address;
    string fvk_hex;
    string ufvk;
    sequence<u8> qr_data;
    string ur_string;
};

// Zcash sync metadata
dictionary ZcashSyncInfo {
    string anchor_hex;
    u32 anchor_height;
    boolean mainnet;
    u64 synced_at;  // unix timestamp (seconds), device clock at import
    u32 anchor_time;  // anchor block header unix time (chain truth), 0 = unknown
};

// Zcash verified note display (from note sync)
dictionary ZcashVerifiedNoteDisplay {
    u64 value;
    string nullifier_hex;
    u32 block_height;
};

// Zcash note sync result
dictionary ZcashNoteSyncResult {
    u32 notes_verified;
    u64 total_balance;
    string anchor_hex;
    u32 anchor_height;
    boolean mainnet;
    boolean anchor_verified;
    u64 synced_at;
    u32 anchor_time;  // anchor block header unix time (chain truth), 0 = unknown
};

// Live scan progress for animated zcash-notes QR (zoda transport).
dictionary ZcashNotesScanProgress {
    u32 have;
    i32 needed;
    boolean complete;
};


[Enum]
interface Card {
    AuthorCard(MAddressCard f);
    AuthorPlainCard(MSCId f);
    AuthorPublicKeyCard(MVerifierDetails f);
    BalanceCard(MSCCurrency f);
    BitVecCard(string f);
    BlockHashCard(string f);
    CallCard(MSCCall f);
    DefaultCard(string f);
    DerivationsCard(sequence<SeedKeysPreview> f);
    EnumVariantNameCard(MSCEnumVariantName f);
    EraImmortalCard();
    EraMortalCard(MSCEraMortal f);
    ErrorCard(string f);
    FieldNameCard(MSCFieldName f);
    FieldNumberCard(MSCFieldNumber f);
    IdCard(MSCId f);
    IdentityFieldCard(string f);
    MetaCard(MMetadataRecord f);
    NameVersionCard(MSCNameVersion f);
    NetworkGenesisHashCard(string f);
    NetworkNameCard(string f);
    NetworkInfoCard(MSCNetworkInfo f);
    NewSpecsCard(NetworkSpecs f);
    NonceCard(string f);
    NoneCard();
    PalletCard(string f);
    TextCard(string f);
    TipCard(MSCCurrency f);
    TipPlainCard(string f);
    TxSpecCard(string f);
    TxSpecPlainCard(MSCTxSpecPlain f);
    TypesInfoCard(MTypesInfo f);
    VarNameCard(string f);
    VerifierCard(MVerifierDetails f);
    WarningCard(string f);
    PenumbraSummaryCard(PenumbraTransactionSummary f);
    PenumbraSpendCard(PenumbraSpendAction f);
    PenumbraOutputCard(PenumbraOutputAction f);
    PenumbraSwapCard(PenumbraSwapAction f);
    PenumbraDelegateCard(PenumbraDelegateAction f);
    PenumbraVoteCard(PenumbraVoteAction f);
    PenumbraGenericActionCard(PenumbraGenericAction f);
    PenumbraSchemaCard(PenumbraSchemaInfo f);
    ZcashSummaryCard(ZcashTransactionSummary f);
    ZcashOrchardSpendCard(ZcashOrchardSpend f);
    ZcashOrchardOutputCard(ZcashOrchardOutput f);
};
