namespace signer {
    FooterButton? action_get_name([ByRef] Action action);

    // ── protocol module runtime (docs/keystone-compat-pczt-signing.md) ──
    // Loads the wasm protocol module (APK asset or A/B slot) and drives the
    // PCZT flows. Module bytes are passed per-call for now; slot management
    // arrives with the update installer.
    [Throws=ErrorDisplayed]
    sequence<ModulePcztSummary> module_summarize_request([ByRef] sequence<u8> module_wasm, [ByRef] sequence<u8> payload);

    // Verify a signed module package (2-of-3 manifest, hash, kernel gate,
    // anti-rollback). Fails closed while release keys are placeholders.
    [Throws=ErrorDisplayed]
    ModulePackageInfo module_verify_package([ByRef] sequence<u8> package, u32 last_installed_version, sequence<u8>? base);

    // Release signing: this device as one of the 2-of-3 key holders.
    [Throws=ErrorDisplayed]
    string release_signing_pubkey([ByRef] string seed_phrase);

    [Throws=ErrorDisplayed]
    ReleaseSigningRequest release_classify_request([ByRef] sequence<u8> prefix);

    [Throws=ErrorDisplayed]
    string release_sign_request([ByRef] string seed_phrase, [ByRef] sequence<u8> prefix);

    // Version of the module baked into the APK. The slot store uses it so a
    // stale installed slot cannot shadow a newer module from an APK update.
    u32 baked_module_version();

    // Instantiate + ABI-probe a staged module before activation.
    boolean module_self_test([ByRef] sequence<u8> wasm);

    [Throws=ErrorDisplayed]
    sequence<u8> module_sign_request([ByRef] sequence<u8> module_wasm, [ByRef] sequence<u8> payload, [ByRef] string seed_phrase, u32 account, boolean mainnet);

    // Frame a module sign-response envelope as UR strings for animated QR
    // display (ur:zigner-module). max_fragment_len: 0 = single QR.
    [Throws=ErrorDisplayed]
    sequence<string> module_response_to_ur([ByRef] sequence<u8> response, u32 active_module_version, u32 max_fragment_len);

    // Fountain-decode ur:zigner-module REQUEST frames to the raw prelude
    // envelope bytes ([0x53][crypto][tx_type] || payload). No CBOR unwrap:
    // the request side ships the bare envelope through the UR fountain.
    [Throws=ErrorDisplayed]
    sequence<u8> decode_ur_module_request(sequence<string> ur_parts);


    [Throws=ErrorDisplayed]
    void init_navigation([ByRef] string dbname, sequence<string> seed_names);

    [Throws=ErrorDisplayed]
    ActionResult backend_action(Action action, [ByRef] string details, [ByRef] string seed_phrase);

    [Throws=ErrorDisplayed]
    void update_seed_names(sequence<string> seed_names);

    [Throws=ErrorDisplayed]
    u32 qrparser_get_packets_total([ByRef] string data, boolean cleaned);

    [Throws=QrSequenceDecodeError]
    DecodeSequenceResult qrparser_try_decode_qr_sequence([ByRef] sequence<string> data, string? password, boolean cleaned);

    [Throws=ErrorDisplayed]
    MKeyDetails generate_secret_key_qr([ByRef] string public_key, [ByRef] string expected_seed_name, [ByRef] string network_specs_key, [ByRef] string seed_phrase, string? key_password);

    [Throws=ErrorDisplayed]
    void import_derivations(sequence<SeedKeysPreview> seed_derived_keys);

    [Throws=ErrorDisplayed]
    DDPreview preview_dynamic_derivations(record<string, string> seeds, string payload);

    [Throws=ErrorDisplayed]
    sequence<SeedKeysPreview> populate_derivations_has_pwd(record<string, string> seeds, sequence<SeedKeysPreview> seed_derived_keys);

    [Throws=ErrorDisplayed]
    DerivationCheck substrate_path_check([ByRef] string seed_name, [ByRef] string path, [ByRef] string network);

    [Throws=ErrorDisplayed]
    void try_create_address([ByRef] string seed_name, [ByRef] string seed_phrase, [ByRef] string path, [ByRef] string network);

    [Throws=ErrorDisplayed]
    void try_create_address_by_genesis([ByRef] string seed_name, [ByRef] string seed_phrase, [ByRef] string path, [ByRef] string genesis_hash_hex);

    [Throws=ErrorDisplayed]
    MSignedTransaction sign_dd_transaction([ByRef] sequence<string> payload, record<string, string> seeds);

    [Throws=ErrorDisplayed]
    void history_init_history_with_cert();

    [Throws=ErrorDisplayed]
    void history_init_history_no_cert();

    [Throws=ErrorDisplayed]
    void history_device_was_online();

    [Throws=ErrorDisplayed]
    boolean history_get_warnings();

    [Throws=ErrorDisplayed]
    void history_acknowledge_warnings();

    [Throws=ErrorDisplayed]
    void history_entry_system(Event event);

    [Throws=ErrorDisplayed]
    void history_seed_was_shown([ByRef] string seed_name);

    [Throws=ErrorDisplayed]
    MKeysInfoExport export_key_info([ByRef] string seed_name, ExportedSet exported_set);

    [Throws=ErrorDisplayed]
    MKeysNew keys_by_seed_name([ByRef] string seed_name);

    // Owner account bound to this phone's validator slot; shown on create-validator cards.
    void set_bound_operator(string? owner);

    // Ed25519 + ChaCha20-Poly1305 for the validator signer, so Android 6-12
    // (no JCA Ed25519 before API 33, no ChaCha20-Poly1305 before API 28) work.
    [Throws=ErrorDisplayed]
    sequence<u8> ed25519_pubkey_from_seed([ByRef] sequence<u8> seed);
    [Throws=ErrorDisplayed]
    sequence<u8> ed25519_sign([ByRef] sequence<u8> seed, [ByRef] sequence<u8> msg);
    boolean ed25519_verify([ByRef] sequence<u8> pubkey, [ByRef] sequence<u8> msg, [ByRef] sequence<u8> sig);
    [Throws=ErrorDisplayed]
    sequence<u8> chacha20poly1305_seal([ByRef] sequence<u8> key, [ByRef] sequence<u8> nonce, [ByRef] sequence<u8> aad, [ByRef] sequence<u8> plain);
    [Throws=ErrorDisplayed]
    sequence<u8> chacha20poly1305_open([ByRef] sequence<u8> key, [ByRef] sequence<u8> nonce, [ByRef] sequence<u8> aad, [ByRef] sequence<u8> ct);

    [Throws=ErrorDisplayed]
    sequence<u8> encode_to_qr([ByRef] sequence<u8> payload, boolean is_danger);

    [Throws=ErrorDisplayed]
    MManageNetworks get_managed_networks();

    void init_logging(string tag);

    [Throws=ErrorDisplayed]
    MLog get_logs();

    [Throws=ErrorDisplayed]
    MLogDetails get_log_details(u32 order);

    [Throws=ErrorDisplayed]
    void clear_log_history();

    [Throws=ErrorDisplayed]
    void handle_log_comment([ByRef] string user_input);

    [Throws=ErrorDisplayed]
    MSeeds get_seeds([ByRef] sequence<string> names_phone_knows);

    [Throws=ErrorDisplayed]
    MKeyDetails get_key_set_public_key([ByRef] string address, [ByRef] string network_specs_key);

    [Throws=ErrorDisplayed]
    void remove_derived_key([ByRef] string address, [ByRef] string network_specs_key);

    [Throws=ErrorDisplayed]
    void remove_key_set([ByRef] string address_key);

    [Throws=ErrorDisplayed]
    MNetworkDetails get_managed_network_details([ByRef] string network_key);

    [Throws=ErrorDisplayed]
    void remove_metadata_on_managed_network([ByRef] string network_key, [ByRef] string metadata_specs_version);

    sequence<string> seed_phrase_guess_words([ByRef] string user_input);

    [Throws=ErrorDisplayed]
    void remove_managed_network([ByRef] string network_key);

    [Throws=ErrorDisplayed]
    MVerifierDetails get_verifier_details();

    boolean validate_seed_phrase([ByRef] string seed_phrase);

    [Throws=ErrorDisplayed]
    MNewSeedBackup print_new_seed([ByRef] string new_seed_name);

    [Throws=ErrorDisplayed]
    void check_db_version();

    [Throws=ErrorDisplayed]
    void create_key_set([ByRef] string seed_name, [ByRef] string seed_phrase, sequence<string> networks);

    [Throws=ErrorDisplayed]
    MSignSufficientCrypto get_keys_for_signing();

    [Throws=ErrorDisplayed]
    MSufficientCryptoReady sign_metadata_with_key([ByRef] string network_key, [ByRef] string metadata_specs_version, [ByRef] string signing_address_key, [ByRef] string seed_phrase, string? password);

    [Throws=ErrorDisplayed]
    MSufficientCryptoReady sign_network_spec_with_key([ByRef] string network_key, [ByRef] string signing_address_key, [ByRef] string seed_phrase, string? password);

    [Throws=ErrorDisplayed]
    boolean validate_key_password([ByRef] string seed_name, [ByRef] string seed_phrase, [ByRef] string password);

    string bs_generate_passphrase(u32 n);

    [Throws=ErrorDisplayed]
    sequence<QrData> bs_encrypt([ByRef] string secret, [ByRef] string title, [ByRef] string passphrase, u32 total_shards, u32 required_shards);

    // Export seed backup data as JSON with account metadata
    [Throws=ErrorDisplayed]
    string bs_export_backup_data([ByRef] string seed_name, [ByRef] string seed_phrase);

    // Export seed backup as UR-encoded QR images for device-to-device migration (animated QR)
    // max_fragment_len: 0 = single QR, 200-500 typical for animated QR
    [Throws=ErrorDisplayed]
    sequence<QrData> export_backup_qr([ByRef] string seed_name, [ByRef] string seed_phrase, u32 max_fragment_len);

    // Export seed backup as UR-encoded string frames for device-to-device migration
    // max_fragment_len: 0 = single QR, 200-500 typical for animated QR
    [Throws=ErrorDisplayed]
    sequence<string> export_backup_ur([ByRef] string seed_name, [ByRef] string seed_phrase, u32 max_fragment_len);

    // Decode UR-encoded backup QR frames and return JSON string
    [Throws=ErrorDisplayed]
    string decode_backup_ur(sequence<string> ur_parts);

    // Penumbra FVK export - generate viewing key QR for Prax import
    [Throws=ErrorDisplayed]
    PenumbraFvkExport export_penumbra_fvk([ByRef] string seed_phrase, u32 account_index, [ByRef] string label);

    // Cosmos accounts export - generate addresses QR for Zafu import
    // network_name filters to a single chain (e.g. "noble"), empty string exports all
    [Throws=ErrorDisplayed]
    CosmosAccountExport export_cosmos_accounts([ByRef] string seed_phrase, u32 account_index, [ByRef] string label, [ByRef] string network_name);

    // ========================================================================
    // Cosmos cold signing functions
    // ========================================================================

    // Parse Cosmos sign request from QR hex data
    [Throws=ErrorDisplayed]
    CosmosSignRequest parse_cosmos_sign_request([ByRef] string qr_hex);

    // Sign Cosmos transaction and return 64-byte signature
    [Throws=ErrorDisplayed]
    sequence<u8> sign_cosmos_transaction([ByRef] string seed_phrase, CosmosSignRequest request);

    // Compressed secp256k1 pubkey (66 hex chars) for the key that signs.
    [Throws=ErrorDisplayed]
    string cosmos_public_key([ByRef] string seed_phrase, u32 account_index, u32 address_index);

    [Throws=ErrorDisplayed]
    string cosmos_public_key_for_signers([ByRef] string seed_phrase, CosmosSignRequest request);

    // cw-orch answer QR. 33-byte pubkey || 64-byte signature, as `ur:cworch-sig`.
    // max_fragment_len 0 is one code when the text fits, otherwise fountain frames.
    [Throws=ErrorDisplayed]
    sequence<string> encode_cworch_signature([ByRef] string pubkey_hex, sequence<u8> signature, u32 max_fragment_len);

    // ========================================================================
    // Penumbra cold signing functions
    // ========================================================================

    // Parse Penumbra sign request from QR hex data
    [Throws=ErrorDisplayed]
    PenumbraSignRequest parse_penumbra_sign_request([ByRef] string qr_hex);

    // Sign Penumbra transaction and return encoded signature QR bytes
    [Throws=ErrorDisplayed]
    sequence<u8> sign_penumbra_transaction([ByRef] string seed_phrase, PenumbraSignRequest request);

    // ========================================================================
    // Zcash simple sign request (from Zafu wallet)
    // ========================================================================

    // Parse Zcash simple sign request from QR hex data
    [Throws=ErrorDisplayed]
    ZcashSimpleSignRequest parse_zcash_sign_request([ByRef] string qr_hex);

    // Sign Zcash simple sign request and return signature QR hex string
    [Throws=ErrorDisplayed]
    string sign_zcash_simple([ByRef] string seed_phrase, ZcashSimpleSignRequest request);

    // ========================================================================
    // Zcash cold signing functions
    // ========================================================================

    // Zcash FVK export - generate viewing key QR for Zafu/Prax import
    [Throws=ErrorDisplayed]
    ZcashFvkExport export_zcash_fvk([ByRef] string seed_phrase, u32 account_index, [ByRef] string label, boolean mainnet);

    // Get a diversified Zcash Orchard address at a specific diversifier index
    [Throws=ErrorDisplayed]
    string get_zcash_diversified_address([ByRef] string seed_phrase, u32 account_index, u32 diversifier_index, boolean mainnet);

    // Get the transparent (t-address) for a Zcash account
    [Throws=ErrorDisplayed]
    string get_zcash_transparent_address([ByRef] string seed_phrase, u32 account, boolean mainnet);

    // ========================================================================
    // Zcash note sync (verified balance via animated QR)
    // ========================================================================

    // Decode UR-encoded zcash-notes, verify merkle paths, store verified notes
    [Throws=ErrorDisplayed]
    ZcashNoteSyncResult decode_and_verify_zcash_notes(sequence<string> ur_parts);

    // Pure scan-progress probe: how many zcash-notes frames collected (have),
    // how many needed to reconstruct (needed, -1 until known), and whether
    // reconstruction is possible now (complete). No verify/store; the camera
    // polls this to drive the progress counter and decide when to call
    // decode_and_verify_zcash_notes.
    ZcashNotesScanProgress zcash_notes_scan_progress(sequence<string> parts);

    // Get all verified zcash notes
    [Throws=ErrorDisplayed]
    sequence<ZcashVerifiedNoteDisplay> get_zcash_verified_notes();

    // Get total verified zcash balance (zatoshis)
    [Throws=ErrorDisplayed]
    u64 get_zcash_verified_balance();

    // Get sync info (anchor, height, timestamp) — null if never synced
    [Throws=ErrorDisplayed]
    ZcashSyncInfo? get_zcash_sync_info();

    // Clear all stored zcash notes
    [Throws=ErrorDisplayed]
    void clear_zcash_notes();

    // ========================================================================
    // PCZT/UR functions for Zashi hardware wallet compatibility
    // ========================================================================

    // Decode UR-encoded PCZT from QR scan(s)
    // ur_parts: vector of scanned QR strings (for animated QR, pass all parts)
    [Throws=ErrorDisplayed]
    sequence<u8> decode_ur_zcash_pczt(sequence<string> ur_parts);

    // Sign a PCZT with the spending key derived from seed phrase
    // Returns the signed PCZT bytes
    [Throws=ErrorDisplayed]
    sequence<u8> sign_zcash_pczt([ByRef] string seed_phrase, u32 account_index, sequence<u8> pczt_bytes);

    // Encode signed PCZT as UR string(s) for QR display
    // max_fragment_len: max bytes per QR (0 = no limit, single QR)
    // Returns vector of UR strings (animated QR parts)
    [Throws=ErrorDisplayed]
    sequence<string> encode_signed_pczt_ur(sequence<u8> pczt_bytes, u32 max_fragment_len);

    // Get signing context: verified balance + note count + anchor info
    // Used by the sign review screen to show what the signer knows
    [Throws=ErrorDisplayed]
    ZcashSignContext get_zcash_sign_context();

    // Inspect a PCZT: extract spend/output details, cross-reference against verified notes
    // Returns a structured summary for display before signing
    [Throws=ErrorDisplayed]
    ZcashPcztInspection inspect_zcash_pczt(sequence<u8> pczt_bytes);

    // High-level: sign PCZT from UR QR and return signed UR QR parts
    // This is the main entry point for Zashi compatibility
    [Throws=ErrorDisplayed]
    sequence<string> sign_zcash_pczt_ur([ByRef] string seed_phrase, u32 account_index, sequence<string> ur_parts, u32 max_fragment_len);

    // ========================================================================
    // Ed25519 identity (zafu-compatible, rotatable)
    // ========================================================================

    // Derive base identity pubkey (zafu-compatible: HMAC-SHA512("zafu-identity", mnemonic + '\0' + index))
    [Throws=ErrorDisplayed]
    string auth_derive_identity([ByRef] string seed_phrase, u32 index);

    // Derive domain-scoped identity (per-service, no cross-site correlation)
    [Throws=ErrorDisplayed]
    string auth_derive_domain_identity([ByRef] string seed_phrase, [ByRef] string domain, u32 index);

    // Sign auth challenge with base identity
    [Throws=ErrorDisplayed]
    AuthSignResult auth_sign_challenge([ByRef] string seed_phrase, u32 index, [ByRef] string domain, [ByRef] string nonce, u64 timestamp);

    // Sign auth challenge with domain-scoped identity
    [Throws=ErrorDisplayed]
    AuthSignResult auth_sign_domain_challenge([ByRef] string seed_phrase, [ByRef] string domain, u32 index, [ByRef] string nonce, u64 timestamp);

    // Verify an auth signature
    [Throws=ErrorDisplayed]
    boolean auth_verify([ByRef] string pubkey_hex, [ByRef] string signature_hex, [ByRef] string domain, [ByRef] string nonce, u64 timestamp);

    // Parse ZID sign challenge QR (JSON), sign with derived key, return JSON response.
    [Throws=ErrorDisplayed]
    string sign_zid_qr([ByRef] string seed_phrase, [ByRef] string qr_json);

    // Derive a 12-word hot wallet mnemonic from the master seed.
    // Used for ZID identity, pro subscription, and daily spending in zafu.
    [Throws=ErrorDisplayed]
    string derive_hot_wallet([ByRef] string seed_phrase);

    // Derive hot wallet mnemonic and encode as ur:zafu-hot-wallet QR PNG.
    [Throws=ErrorDisplayed]
    sequence<u8> derive_hot_wallet_qr([ByRef] string seed_phrase);

    // ========================================================================
    // Contacts (address book)
    // ========================================================================

    // Store a contact (address → label mapping)
    [Throws=ErrorDisplayed]
    void store_contact([ByRef] string address, [ByRef] string label, [ByRef] string chain_id);

    // Get all contacts as JSON array
    [Throws=ErrorDisplayed]
    string get_contacts();

    // Get contact label by address (empty string if not found)
    [Throws=ErrorDisplayed]
    string get_contact_label([ByRef] string address);

    // Delete a contact by address
    [Throws=ErrorDisplayed]
    void delete_contact([ByRef] string address);

    // Export contacts as CBOR for QR display
    [Throws=ErrorDisplayed]
    sequence<u8> export_contacts_cbor();

    // Import contacts from CBOR (from QR scan)
    [Throws=ErrorDisplayed]
    u32 import_contacts_cbor(sequence<u8> cbor);

    // Export contacts as UR-encoded animated QR frames
    [Throws=ErrorDisplayed]
    sequence<string> export_contacts_ur(u32 max_fragment_len);

    // Export contacts as zoda transport frames (verified erasure coding)
    // k = minimum frames needed, n = total frames generated
    [Throws=ErrorDisplayed]
    sequence<string> export_contacts_zt(u8 k, u8 n);

    // ========================================================================
    // Encrypted backup (seed phrase = decryption key)
    // ========================================================================

    // Create encrypted backup of all data, returns UR frames
    [Throws=ErrorDisplayed]
    sequence<string> create_encrypted_backup([ByRef] string seed_name, [ByRef] string seed_phrase, u32 max_fragment_len);

    // Restore from encrypted backup UR frames, returns accounts JSON
    [Throws=ErrorDisplayed]
    string restore_encrypted_backup([ByRef] string seed_phrase, sequence<string> ur_parts);

    // ========================================================================
    // FROST threshold multisig (t-of-n)
    // All inputs/outputs are JSON strings with hex-encoded FROST data.
    // ========================================================================

    // DKG round 1: generate ephemeral identity + signed commitment
    // Returns JSON: { "secret": hex, "broadcast": hex }
    [Throws=ErrorDisplayed]
    string frost_dkg_part1(u16 max_signers, u16 min_signers);

    // DKG round 2: process signed round1 broadcasts
    // peer_broadcasts_json: JSON array of hex strings
    // Returns JSON: { "secret": hex, "peer_packages": [hex, ...] }
    [Throws=ErrorDisplayed]
    string frost_dkg_part2([ByRef] string secret_hex, [ByRef] string peer_broadcasts_json);

    // DKG round 3: finalize — returns key package + public key package
    // Returns JSON: { "key_package": hex, "public_key_package": hex, "ephemeral_seed": hex }
    [Throws=ErrorDisplayed]
    string frost_dkg_part3([ByRef] string secret_hex, [ByRef] string round1_broadcasts_json, [ByRef] string round2_packages_json);

    // Signing round 1: generate nonces + signed commitments
    // Returns JSON: { "nonces": hex, "commitments": hex }
    [Throws=ErrorDisplayed]
    string frost_sign_round1([ByRef] string ephemeral_seed_hex, [ByRef] string key_package_hex);

    // Spend-authorize round 2: produce FROST share for one Orchard action
    // sighash + alpha are bound — alpha IS the FROST randomizer
    [Throws=ErrorDisplayed]
    string frost_spend_sign_round2([ByRef] string key_package_hex, [ByRef] string nonces_hex, [ByRef] string sighash_hex, [ByRef] string alpha_hex, [ByRef] string commitments_json);

    // Authenticated variant: share is wrapped in a SignedMessage so the coordinator
    // maps it by VK-derived FROST id, not BTreeMap position. Use this when sharing
    // over the relay to prevent the positional-fallback id-mismatch aggregate bug.
    [Throws=ErrorDisplayed]
    string frost_spend_sign_round2_signed([ByRef] string ephemeral_seed_hex, [ByRef] string key_package_hex, [ByRef] string nonces_hex, [ByRef] string sighash_hex, [ByRef] string alpha_hex, [ByRef] string commitments_json);

    // Sign multiple actions at once (one share per alpha)
    // Returns JSON: { "shares": [hex, ...] }
    [Throws=ErrorDisplayed]
    string frost_spend_sign_actions([ByRef] string key_package_hex, [ByRef] string nonces_hex, [ByRef] string sighash_hex, [ByRef] string alphas_json, [ByRef] string commitments_json);

    // Derive raw Orchard address from FROST group key (hex-encoded 43 bytes)
    [Throws=ErrorDisplayed]
    string frost_derive_address_raw([ByRef] string public_key_package_hex, u32 diversifier_index);

    // gh #17: verify a FROST payout PCZT before signing — recompute the sighash
    // and OVK-decode outputs with the group UFVK. Returns JSON; caller blocks the
    // signature on sighash/recipient/amount mismatch. See frost_multisig::frost_verify_pczt.
    [Throws=ErrorDisplayed]
    string frost_verify_pczt([ByRef] string pczt_hex, [ByRef] string claimed_sighash_hex, [ByRef] string orchard_fvk_uview);

    // ========================================================================
    // FROST wallet storage (key packages from DKG)
    // ========================================================================

    // Store FROST wallet after DKG completion, returns wallet_id hex.
    // The `orchard_fvk_uview / address / relay_url` arguments are zafu-side
    // public-derived data (computed during DKG FVK echo). Pass empty strings
    // for legacy callers; new callers pass them so the airgap re-add QR can
    // hand them back to a fresh zafu install during recovery.
    [Throws=ErrorDisplayed]
    string frost_store_wallet(
        [ByRef] string key_package_hex,
        [ByRef] string public_key_package_hex,
        [ByRef] string ephemeral_seed_hex,
        [ByRef] string label,
        u16 min_signers,
        u16 max_signers,
        boolean mainnet,
        [ByRef] string orchard_fvk_uview,
        [ByRef] string address,
        [ByRef] string relay_url
    );

    // List all stored FROST wallets (summaries, no secrets)
    [Throws=ErrorDisplayed]
    sequence<FrostWalletSummaryFFI> frost_list_wallets();

    // Load FROST wallet secrets for signing (key_package + ephemeral_seed)
    // Returns JSON: { "key_package": hex, "ephemeral_seed": hex, "public_key_package": hex }
    [Throws=ErrorDisplayed]
    string frost_load_wallet([ByRef] string wallet_id);

    // Delete a FROST wallet
    [Throws=ErrorDisplayed]
    void frost_delete_wallet([ByRef] string wallet_id);

    // Rename a FROST wallet (label only, no key material touched).
    // Empty / whitespace-only labels are rejected.
    [Throws=ErrorDisplayed]
    void frost_rename_wallet(
        [ByRef] string wallet_id,
        [ByRef] string new_label
    );

    // Derive UFVK + address from a FROST public_key_package + host-broadcast sk.
    // Returns JSON {"orchard_fvk_uview": "...", "address": "..."}. Lets zigner
    // compute the metadata locally during DKG instead of round-tripping with zafu.
    [Throws=ErrorDisplayed]
    string frost_derive_metadata(
        [ByRef] string public_key_package_hex,
        [ByRef] string sk_hex,
        boolean mainnet,
        u32 diversifier_index
    );

    // Update public-derived metadata on an existing FROST wallet (no secret
    // material). Empty strings are ignored. Used during DKG to receive
    // orchard FVK / address / relay URL from zafu.
    [Throws=ErrorDisplayed]
    void frost_set_wallet_metadata(
        [ByRef] string wallet_id,
        [ByRef] string orchard_fvk_uview,
        [ByRef] string address,
        [ByRef] string relay_url
    );

    // FROST backup: encrypt one wallet's share material into a portable
    // JSON envelope (PBKDF2-HMAC-SHA512 + AES-GCM-256, format identical to
    // zafu's @repo/encryption Box/KeyPrint shape). Returns the envelope JSON.
    [Throws=ErrorDisplayed]
    string frost_export_backup_envelope(
        [ByRef] string wallet_id,
        [ByRef] string passphrase
    );

    // FROST backup restore: decrypt an envelope JSON, store the wallet,
    // return its new device-local wallet_id (hex).
    [Throws=ErrorDisplayed]
    string frost_import_backup_envelope(
        [ByRef] string envelope_json,
        [ByRef] string passphrase
    );

    // Encrypt every FROST wallet on this device into a single batch envelope.
    // Caller writes the returned JSON to a `.json` file.
    [Throws=ErrorDisplayed]
    string frost_export_all_backup_envelope([ByRef] string passphrase);

    // Decrypt a batch envelope and import every share inside.
    // Skips wallets whose publicKeyPackage already exists.
    // Returns JSON {"imported": N, "skipped": M}.
    [Throws=ErrorDisplayed]
    string frost_import_all_backup_envelope(
        [ByRef] string envelope_json,
        [ByRef] string passphrase
    );

    // This device's backup recipient, as an `ssh-ed25519 AAAA...` line.
    // Show it so the user can hand it to a co-signer who wants to address a
    // backup to this device.
    [Throws=ErrorDisplayed]
    string age_device_recipient([ByRef] string seed_phrase);

    // Export every FROST share encrypted to public keys instead of under a
    // passphrase, removing the separate-secret failure mode: the seed the
    // user already backs up is what opens it.
    //
    // This device's own recipient is always included; extra_recipients adds
    // co-signers or a second device, which is the point - a backup only this
    // seed can open dies at the same moment the seed does.
    //
    // Recipients are `ssh-ed25519 ...` lines or native age1... recipients.
    // Returns armored age text; the caller writes it to a file.
    //
    // NOTE: deliberately NOT a zafu-readable format. The passphrase envelope
    // matches zafu's @repo/encryption shape; this one is an age file and zafu
    // cannot open it. Device-to-device restore is the intended use, and the
    // passphrase path stays for backing up to someone with no such key.
    [Throws=ErrorDisplayed]
    string frost_export_all_backup_age(
        [ByRef] string seed_phrase,
        sequence<string> extra_recipients
    );

    // Import an age-encrypted batch backup addressed to this device.
    // Returns the same JSON {"imported": N, "skipped": M}.
    [Throws=ErrorDisplayed]
    string frost_import_all_backup_age(
        [ByRef] string seed_phrase,
        [ByRef] string armored
    );

    // List every anchor verifier the device trusts (enabled and disabled).
    // The first call after install returns the built-in entry.
    [Throws=ErrorDisplayed]
    sequence<AnchorVerifierFFI> list_anchor_verifiers();

    // Decode a `ur:zcash-verifier-key` UR (single or animated) into the
    // pubkey + label, WITHOUT adding it. The native layer is expected to
    // show a confirmation screen with the full pubkey hex before calling
    // add_anchor_verifier.
    [Throws=ErrorDisplayed]
    AnchorVerifierImport decode_verifier_key_qr(sequence<string> ur_parts);

    // Add a verifier to the trust list. Returns Err if a verifier with
    // the same pubkey is already present.
    [Throws=ErrorDisplayed]
    void add_anchor_verifier(
        [ByRef] string pubkey_hex,
        [ByRef] string label
    );

    // Remove a verifier. Returns Err if doing so would leave the device
    // with zero enabled verifiers AND attestation is required (sticky
    // FROST flag set) — that combination would block all future note
    // imports. Caller can pass `force = true` to override (after a clear
    // user confirmation).
    [Throws=ErrorDisplayed]
    void remove_anchor_verifier(
        [ByRef] string pubkey_hex,
        boolean force
    );

    // Toggle a verifier's enabled flag. Same "would lock the device"
    // protection as remove_anchor_verifier when going from on to off.
    [Throws=ErrorDisplayed]
    void set_anchor_verifier_enabled(
        [ByRef] string pubkey_hex,
        boolean enabled,
        boolean force
    );


    // Encode a device-signed ur:zafu-result (single-frame UR strings).

    // Encode a device-signed ur:zafu-status (single-frame UR strings).

    // Decode + verify a ur:zafu-result single-frame UR.

    // Decode + verify a ur:zafu-status single-frame UR.

};

