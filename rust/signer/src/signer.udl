[Error]
interface ErrorDisplayed {
    Str(string s);
    MutexPoisoned();
    DbNotInitialized();
    LoadMetaUnknownNetwork(string name);
    SpecsKnown(string name, Encryption encryption);
    MetadataKnown(string name, u32 version);
    MetadataOutdated(string name, u32 have, u32 want);
    UnknownNetwork(H256 genesis_hash, Encryption encryption);
    NoMetadata(string name);
    WrongPassword();
    DbSchemaMismatch();
};

[Error]
interface QrSequenceDecodeError {
    BananaSplitWrongPassword();
    BananaSplit(string s);
    GenericError(string s);
};

// What a release-signing device is being asked to attest to. Shown before
// approval; the operator compares module_hash_hex against their own build.
dictionary ReleaseSigningRequest {
    u32 module_version;
    u32 min_kernel_version;
    string module_hash_hex;
    string description;
};

dictionary ModulePackageInfo {
    u32 module_version;
    u32 min_kernel_version;
    string description;
    string module_hash_hex;
    sequence<u8> wasm;
};

dictionary ModulePcztSummary {
    u32 orchard_actions;
    u32 ironwood_actions;
    u32 transparent_inputs;
    u64? fee_zat;
    sequence<string> output_lines;
    // True when the module recognized this PCZT as a Zcash voting
    // delegation authorization rather than a payment - see
    // `pczt_signing::detect_delegation`. The confirmation screen must show
    // "voting delegation authorization", not a payment recipient/amount,
    // when this is set.
    boolean is_delegation;
};

dictionary MetaValuesDisplay {
    string name;
    u32 version;
    H256 meta_hash;
};

[Custom]
typedef sequence<u8> H256;

[Custom]
typedef sequence<u8> Ed25519Public;

[Custom]
typedef sequence<u8> Sr25519Public;

[Custom]
typedef sequence<u8> EcdsaPublic;

[Custom]
typedef sequence<string> MultiSigner;

[Enum]
interface VerifierValue {
    Standard(MultiSigner m);
};

dictionary Verifier {
    VerifierValue? v;
};

enum Encryption {
    "Ed25519",
    "Sr25519",
    "Ecdsa",
    "Ethereum",
    "Penumbra",
    "Zcash",
    "LedgerEd25519",
    "Cosmos",
    "Bitcoin",
    "Nostr",
    "AtProtocol",
};

[Enum]
interface ValidCurrentVerifier {
    General();
    Custom(Verifier v);
};

